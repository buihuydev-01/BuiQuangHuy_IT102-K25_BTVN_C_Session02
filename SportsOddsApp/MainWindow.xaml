<Window x:Class="SportsOddsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportsOddsApp"
        xmlns:vm="clr-namespace:SportsOddsApp.ViewModels"
        mc:Ignorable="d"
        Title="Sports Odds Monitor - Theo dõi tỷ lệ cược" 
        Height="700" Width="1400"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Style for DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternatingRowBackground" Value="#F0F8FF"/>
            <Setter Property="RowHeight" Value="35"/>
        </Style>

        <!-- Style for DataGridColumnHeader -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4169E1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- Style for DataGridCell -->
        <Style TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#ADD8E6"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Converter for odds color -->
        <local:OddsColorConverter x:Key="OddsColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Row 1: Buttons and Status -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding RefreshCommand}" 
                                Padding="15,8" 
                                Margin="0,0,10,0"
                                Background="#27AE60"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <TextBlock Text="Làm mới" FontWeight="Bold"/>
                        </Button>

                        <Button Command="{Binding StartAutoRefreshCommand}" 
                                Padding="15,8" 
                                Margin="0,0,10,0"
                                Background="#3498DB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <TextBlock Text="Tự động" FontWeight="Bold"/>
                        </Button>

                        <Button Command="{Binding StopAutoRefreshCommand}" 
                                Padding="15,8"
                                Background="#E74C3C"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <TextBlock Text="Dừng" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1" 
                               Text="{Binding LastUpdateText}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="14"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Trạng thái: " 
                                   Foreground="White" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="#ECF0F1" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
                
                <!-- Row 2: Cookie Input -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="Cookie/Session:" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontWeight="Bold"/>
                    
                    <TextBox Grid.Column="1"
                             Text="{Binding CookieString, UpdateSourceTrigger=PropertyChanged}"
                             Background="#34495E"
                             Foreground="White"
                             BorderBrush="#4169E1"
                             BorderThickness="2"
                             Padding="8,5"
                             VerticalAlignment="Center"
                             FontSize="12"
                             ToolTip="Paste cookie string từ browser DevTools (F12 → Network → Request Headers → Cookie)"/>
                    
                    <TextBlock Grid.Column="2"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center">
                        <Hyperlink Foreground="#3498DB" 
                                   NavigateUri="about:blank"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            <TextBlock Text="Hướng dẫn" FontWeight="Bold"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Matches}"
                  Background="White"
                  BorderBrush="#BDC3C7"
                  BorderThickness="1">
            <DataGrid.Columns>
                <!-- Thời Gian -->
                <DataGridTextColumn Header="Thời Gian" 
                                    Binding="{Binding Time}" 
                                    Width="80"
                                    FontWeight="Bold"
                                    Foreground="#E74C3C"/>

                <!-- Giải đấu -->
                <DataGridTextColumn Header="Giải đấu" 
                                    Binding="{Binding LeagueName}" 
                                    Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="Foreground" Value="#2980B9"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Trận đấu (1 dòng: Team1 - Team2) -->
                <DataGridTextColumn Header="Trận đấu" 
                                    Binding="{Binding MatchDisplay}" 
                                    Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="5,0"/>
                            <Setter Property="Foreground" Value="#2C3E50"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Tỷ số -->
                <DataGridTextColumn Header="Tỷ số" 
                                    Binding="{Binding ScoreDisplay}" 
                                    Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#E74C3C"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="16"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Chấp FT (Full Time) -->
                <DataGridTemplateColumn Header="Chấp FT" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding HdpHome}" 
                                           Foreground="#E74C3C"
                                           FontWeight="Bold"
                                           Margin="5,0"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding HdpAway}" 
                                           Foreground="#3498DB"
                                           FontWeight="Bold"
                                           Margin="5,0"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- T/X FT (Tài/Xỉu Full Time) -->
                <DataGridTemplateColumn Header="T/X FT" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding OuHome}" 
                                           Foreground="#E67E22"
                                           FontWeight="Bold"
                                           Margin="5,0"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding OuAway}" 
                                           Foreground="#16A085"
                                           FontWeight="Bold"
                                           Margin="5,0"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 1X2 FT -->
                <DataGridTemplateColumn Header="1X2 FT" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Odds1}" 
                                           Margin="5,0"
                                           FontWeight="Bold"
                                           Foreground="#E74C3C"/>
                                <TextBlock Text="{Binding OddsX}" 
                                           Margin="5,0"
                                           FontWeight="Bold"
                                           Foreground="#95A5A6"/>
                                <TextBlock Text="{Binding Odds2}" 
                                           Margin="5,0"
                                           FontWeight="Bold"
                                           Foreground="#3498DB"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Chấp H1 - Nhiều mức -->
                <DataGridTemplateColumn Header="Chấp H1 (Tất cả mức)" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                <ItemsControl ItemsSource="{Binding HdpH1Levels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" 
                                                    BorderThickness="0,0,0,1" 
                                                    Padding="5,3"
                                                    Background="#FFF5F5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Line -->
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding Line}" 
                                                               FontWeight="Bold"
                                                               Foreground="#9B59B6"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <!-- Odds -->
                                                    <StackPanel Grid.Column="1" 
                                                                Orientation="Horizontal" 
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding HomeOdds}" 
                                                                   Foreground="#E74C3C"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11"
                                                                   Margin="0,0,5,0"/>
                                                        <TextBlock Text=" | " 
                                                                   Foreground="#BDC3C7"
                                                                   FontSize="11"/>
                                                        <TextBlock Text="{Binding AwayOdds}" 
                                                                   Foreground="#3498DB"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11"
                                                                   Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- T/X H1 - Nhiều mức -->
                <DataGridTemplateColumn Header="T/X H1 (Tất cả mức)" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                <ItemsControl ItemsSource="{Binding OuH1Levels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" 
                                                    BorderThickness="0,0,0,1" 
                                                    Padding="5,3"
                                                    Background="#FFFEF8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Line -->
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding Line}" 
                                                               FontWeight="Bold"
                                                               Foreground="#F39C12"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <!-- Odds -->
                                                    <StackPanel Grid.Column="1" 
                                                                Orientation="Horizontal" 
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding HomeOdds}" 
                                                                   Foreground="#E67E22"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11"
                                                                   Margin="0,0,5,0"/>
                                                        <TextBlock Text=" | " 
                                                                   Foreground="#BDC3C7"
                                                                   FontSize="11"/>
                                                        <TextBlock Text="{Binding AwayOdds}" 
                                                                   Foreground="#16A085"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11"
                                                                   Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 1X2 H1 - Nhiều mức -->
                <DataGridTemplateColumn Header="1X2 H1 (Tất cả mức)" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                <ItemsControl ItemsSource="{Binding Odds1X2H1Levels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" 
                                                    BorderThickness="0,0,0,1" 
                                                    Padding="5,3"
                                                    Background="#F0F8FF">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Odds1}" 
                                                               Foreground="#E74C3C"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Margin="0,0,5,0"/>
                                                    <TextBlock Text=" | " 
                                                               Foreground="#BDC3C7"
                                                               FontSize="11"/>
                                                    <TextBlock Text="{Binding OddsX}" 
                                                               Foreground="#95A5A6"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Margin="5,0"/>
                                                    <TextBlock Text=" | " 
                                                               Foreground="#BDC3C7"
                                                               FontSize="11"/>
                                                    <TextBlock Text="{Binding Odds2}" 
                                                               Foreground="#3498DB"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Trạng thái -->
                <DataGridTextColumn Header="Trạng thái" 
                                    Binding="{Binding StatusText}" 
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#27AE60"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Foreground="White" 
                           VerticalAlignment="Center">
                    <Run Text="Tổng số trận: "/>
                    <Run Text="{Binding Matches.Count, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <ProgressBar Grid.Column="1" 
                             Width="200" 
                             Height="20"
                             IsIndeterminate="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
